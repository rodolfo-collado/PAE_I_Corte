<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.i_corte.ConsultaController"
      spacing="12" alignment="CENTER">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Consulta de Citas"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaCitas" prefWidth="440" prefHeight="250">
        <columns>
            <TableColumn fx:id="colNombre"   text="Nombre"   prefWidth="180"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
            <TableColumn fx:id="colFecha"    text="Fecha"    prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="← Volver" onAction="#volver"/>
        <Button text="Eliminar" onAction="#eliminar"/>
    </HBox>
</VBox>